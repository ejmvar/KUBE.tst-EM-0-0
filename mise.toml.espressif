[tools]
# Python is provided by uv so the free-threaded build can be used.

# mise settings set python.compile=false
#python = "3.14t"
uv = "latest"
cmake = "3.30"
ninja = "1.12"
ccache = "latest"
usage = "latest"
shellcheck = "latest"
#terraform = "latest"

# ### KIND + KUBERNETES ### #

"cargo:worktrunk" = "latest"
#"cargo" = "latest"

[env]
_.python.venv = { path = ".venv" }

# to obtain ESPRESSIF environment
# env -i bash -c '. ~/.espressif/v6.0.2/esp-idf/export.sh && env' | grep -E '^(IDF_|PATH|VIRTUAL_ENV)' > ~/.espressif/v6.0.2/idf_env.txt
# env -i bash -c '. ~/.espressif/v6.0.2/esp-idf/export.sh && env' | grep -E '^(IDF_|PATH|VIRTUAL_ENV)' > ~/.espressif/v6.0.2/idf_env.txt
# 20260812-110913
# ❯ . ~/.espressif/v6.0.2/esp-idf/export.sh ; env | grep -E '^(IDF_|PATH|VIRTUAL_ENV)' > idf_env.txt
# 20260812-111203
# 20260812-112248
# bash -c 'source ~/.espressif/v6.0.2/esp-idf/export.sh >/dev/null 2>&1 && export -p | grep -E "(IDF_|PATH=|VIRTUAL_ENV=)"' > 00-ideas/idf_fast_export.sh
# 20260812-112817
_.source=[
    # AI API Keys
    "~/bin/SECRETS/OpenCode.AI/EXPORT_SECRET_OPENCODE_APIKEY.sh",
    "~/bin/SECRETS/Gemini-Google-Project-20260701/GEMINI_API_KEY.sh",
    "~/bin/SECRETS/OpenCode.AI/EXPORT_SECRET_OPENCODE_APIKEY.sh",
    "~/bin/SECRETS/OpenRouter.AI/EXPORT_SECRET_OPENROUTER_APIKEY.sh",
#    # ESP-IDF Toolchain paths
#    #"~/.espressif/v6.0.2/esp-idf/export.sh"
#    #"00-ideas/idf_env.txt"
    
    # ESP-IDF is loaded by scripts/idf-env.sh, not by mise.
    # "~/.espressif/v6.0.2/esp-idf/export.sh"
    
]

# 1. ESP-IDF Base Configuration
#IDF_PATH = "~/esp/esp-idf"
IDF_CCACHE_ENABLE = "1"



